<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BfAudioSharp</RootNamespace>
    <AssemblyName>BfAudioSharp</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Aiden A</Authors>
    <Description>Reader for NintendoWare Cafe/NX audio formats (BARS/AMTA, BFWAV, BFSTM, BFSTP, BFSAR, BFWAR, BFGRP) with DSP-ADPCM decoding.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BfAudioSharp.Tests" />
  </ItemGroup>

</Project>
